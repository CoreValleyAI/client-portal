# CoreValley console - authentication
#
# Copy to .env.local. With NO variables set the console runs in mock mode:
# the sign-in button signs you in as a seeded local user and no external
# service is needed. Setting KEYCLOAK_ISSUER switches to real OIDC.
#
#   docker compose up -d      # starts Keycloak + Postgres, imports the realm
#   cp .env.example .env.local
#   npm run dev

# ---------------------------------------------------------------------------
# Keycloak (leave commented out to stay in mock mode)
# ---------------------------------------------------------------------------

# Must include the realm path.
KEYCLOAK_ISSUER=http://localhost:8080/realms/corevalley
KEYCLOAK_CLIENT_ID=corevalley-portal
KEYCLOAK_CLIENT_SECRET=corevalley-portal-dev-secret

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------

# Signs the session JWT. Generate with: npx auth secret  (or openssl rand -base64 32)
# Required whenever KEYCLOAK_ISSUER is set; mock mode falls back to a fixed
# development value.
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# The canonical origin of this app. Keycloak's redirect URI must match it.
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Build target
# ---------------------------------------------------------------------------

# "true" produces the static ./out bundle for GitHub Pages. Static export has
# no server, so middleware and /api/auth are dropped and the console falls back
# to mock mode. Leave unset for `npm run dev` and any server deployment.
# NEXT_STATIC_EXPORT=true
